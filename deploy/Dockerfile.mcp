# Jager-C2 MCP Server
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY mcp/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy MCP server code (as jager_mcp to avoid collision with installed 'mcp' package)
COPY mcp/ ./jager_mcp/
COPY builder/ ./builder/

EXPOSE 8000

ENV JAGER_MGMT_URL=http://teamserver:31338
ENV PYTHONPATH=/app
# Run as an SSE server inside Docker (stdio is for local agent harnesses)
ENV MCP_TRANSPORT=sse
ENV MCP_HOST=0.0.0.0
ENV MCP_PORT=8000

CMD ["python", "-c", "from jager_mcp.server import main; main()"]